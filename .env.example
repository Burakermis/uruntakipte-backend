# Kopyala: .env — server.js şu an process.env'i doğrudan okuyor (dotenv
# kurulu değil, prod'da bu değişkenler platformun kendi env mekanizmasıyla
# (Docker/Render/Railway/EAS secrets vb.) enjekte edilir).

PORT=4000

# CANLI DAĞITIMDA "production". Şunlar YALNIZCA NODE_ENV=development (ya da test)
# iken açılır: kimliksiz premium veren POST /api/users/:id/premium, engelli
# sayfalar için fixture yedeği ve (secret boşsa) kimliksiz RevenueCat webhook'u.
# Tanımsız/başka bir değerde hepsi KAPALI kalır. Yerel geliştirmede:
# NODE_ENV=development
# NODE_ENV=production

# Yalnızca yerel geliştirme: istemcinin kendi HTML'ini gönderebilmesine izin verir
# (test-limit-counting.js gibi testler için). Canlıda AÇMA — paylaşılan ürün
# kayıtlarını sahte veriyle zehirlemeye yol açar (bkz. routes/products.js).
# ALLOW_CLIENT_HTML=1

DATABASE_URL=postgres://trackprice:trackprice@localhost:5433/trackprice
REDIS_HOST=localhost
REDIS_PORT=6379
LOG_LEVEL=info

# Virgülle ayrılmış proxy listesi (Bright Data/Oxylabs/Smartproxy vb.) —
# boş bırakılırsa proxysiz devam eder (bkz. scraper/browserFetch.js).
# Örnek: PROXY_LIST=http://user1:pass1@proxy1.example.com:8000,http://user2:pass2@proxy2.example.com:8000
PROXY_LIST=

# RevenueCat webhook'unun Authorization header'ıyla doğrulanması için
# (bkz. routes/webhooks.js) — RevenueCat dashboard'unda webhook eklerken
# aynı değeri "Authorization Header Value" alanına gir.
REVENUECAT_WEBHOOK_SECRET=

# RevenueCat'in sunucu tarafı REST API'sine bizim ATTIĞIMIZ istekler için
# (bkz. routes/users.js POST /:userId/sync-premium) — yukarıdakinin TERSİ
# yönde bir secret. RevenueCat dashboard > Project Settings > API Keys >
# "Secret API Keys" altından alınır; mobile/.env'deki
# EXPO_PUBLIC_REVENUECAT_*_KEY (public SDK key'leri) ile KARIŞTIRMA, bu asla
# istemciye gönderilmemeli.
REVENUECAT_SECRET_KEY=

# İstemci kimliklerini (userId.imza token'ları) imzalayan gizli anahtar — canlıda
# ZORUNLU, en az 32 karakter; yoksa/kısaysa sunucu açılmaz (bkz. auth/token.js).
# Üretmek için: openssl rand -hex 32   (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# Değiştirilirse tüm mevcut token'lar geçersiz olur (uygulama kendini yeniden kaydeder,
# ama eski userId'ye bağlı takipler/premium erişilemez olur) — sızıntı dışında döndürme.
# Yerel geliştirmede (NODE_ENV=development|test) boş bırakılabilir: sabit bir geliştirme anahtarı kullanılır.
AUTH_SECRET=

# Yönetilen Redis için (yerel Docker Redis'inde gerekmez):
REDIS_PASSWORD=
# 1 ise Redis'e TLS ile bağlanılır
REDIS_TLS=

# Ters vekil (nginx/Caddy/yük dengeleyici) arkasında: istek ile uygulama arasındaki GÜVENİLİR
# vekil sayısı (tek vekil için 1). Vekil yoksa boş/0 bırak. "true" kabul edilmez (sahte
# X-Forwarded-For ile hız sınırı aşılır). Yanlış sayı da aynı sorunu yaratır: topolojine göre ver.
TRUST_PROXY=

# Tarayıcıdan API çağrısına izin verilecek kökenler (virgülle ayrılmış). Mobil uygulama CORS kullanmaz; canlıda
# BOŞ bırak (CORS kapalı). Yerelde (NODE_ENV=development) otomatik açıktır.
CORS_ORIGINS=

# Hata izleme (Sentry) DSN'si — BOŞ bırakılırsa izleme tamamen kapalıdır (paket bile yüklenmez). Açarsan gizlilik
# politikası ve mağaza veri beyanları güncellenmeli. Gizli veriler gönderilmeden temizlenir (monitoring/sentry.js).
SENTRY_DSN=
# Sürüm etiketi (isteğe bağlı, ör. git commit): hatayı hangi sürümün verdiğini görmek için
SENTRY_RELEASE=
